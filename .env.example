NEXT_PUBLIC_DEMO_MODE=true

# OpenAI-compatible text model. These variables are read only by server API routes.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=
TEXT_MODEL_NAME=

# Optional local realtime voice gateway preview. Leave empty on Vercel unless you deploy a gateway.
NEXT_PUBLIC_REALTIME_GATEWAY_URL=

# Optional Doubao realtime gateway variables for local gateway experiments.
DOUBAO_REALTIME_API_KEY=
DOUBAO_REALTIME_APP_ID=
DOUBAO_REALTIME_ENDPOINT=
DOUBAO_REALTIME_RESOURCE_ID=
DOUBAO_REALTIME_MODEL=
